{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "target": "es2019",
    "declaration": true,
    "outDir": "./dist",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
  },
  "exclude": ["node_modules", "dist", "**/*.test.*"],
  "include": ["src/**/*"],
}
