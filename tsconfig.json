{
  "compilerOptions": {
    "strict": true,
    "target": "es2021",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./lib",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "exclude": ["node_modules", "lib", "**/*.test.*"],
  "include": ["src/**/*"]
}
