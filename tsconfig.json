{
  "compilerOptions": {
    "strict": true,
    "target": "es2021",

    "module": "ESNext",
    "moduleResolution": "bundler",

    "declaration": true,

    "rootDir": "./src",
    "outDir": "./lib",

    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "skipLibCheck": true,
    "esModuleInterop": true,

    "types": ["jest", "node"]
  },
  "exclude": ["node_modules", "lib"],
  "include": ["src/**/*"]
}
