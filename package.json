  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.js",
  "files": [
    "lib",
    "src",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf lib/* && tsc -p tsconfig.build.json",
    "check:all": "npm run check:type && npm run check:eslint && npm run check:prettier",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "check:type": "tsc --noEmit",
    "fix:prettier": "prettier --write .",
    "test": "jest"
  },
  "keywords": [],
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@typescript-eslint/eslint-plugin": "6.19.1",
    "@typescript-eslint/parser": "6.19.1",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "fake-indexeddb": "5.0.2",
    "jest": "30.4.2",
    "prettier": "3.2.4",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.3.1",
    "another-json": "0.2.0",
    "bs58": "6.0.0",
    "idb": "8.0.0"
  }
}
